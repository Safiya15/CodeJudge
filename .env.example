# ===================================================
# CodeJudge - Global Environment Configuration
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_this_in_production_min32chars
JWT_EXPIRES_IN=7d

# MongoDB Database Connection
MONGODB_URI=mongodb://mongodb:27017/codejudge

# Redis Cache, Queue (BullMQ) & Pub/Sub
REDIS_HOST=redis
REDIS_PORT=6379

# Judge0 Sandboxed Execution Engine
JUDGE0_URL=http://judge0:2358
JUDGE0_API_KEY=

# Offline / Testing Flags (Set to false in production)
MOCK_JUDGE0=false
USE_IN_MEMORY_QUEUE=false

# Frontend Configuration
VITE_API_URL=http://localhost:5000
